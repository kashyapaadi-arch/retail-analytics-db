# Copy to .env and replace placeholders with local MySQL credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=change_me
DB_NAME=retail_db

# Optional data warehouse settings
DW_NAME=retail_dw

# Separate database used by pytest
TEST_DB_NAME=retail_db_test
TEST_DW_NAME=retail_dw_test

